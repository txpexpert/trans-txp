# .env.example — variables d'environnement d'Import-eXPert
# Copier en .env.local pour un essai sur votre ordinateur (npm run dev),
# ou saisir chaque variable dans Vercel → Project → Settings → Environment Variables.
# Ne jamais publier les vraies valeurs sur GitHub.

# ── Supabase (Project Settings → API) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » (secrète, serveur uniquement). Les deux noms sont utilisés dans le code.
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# URL publique, sans « / » final (liens des emails et des documents).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sécurité des sessions (chaînes aléatoires longues, ex. 64 caractères) ─────
USER_SECRET=
ADMIN_SECRET=
# Compte administrateur historique (fallback) et mot de passe du backoffice.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Durées de session en secondes (facultatif).
USER_SESSION_TTL=604800
ADMIN_SESSION_TTL=28800
# Protège la tâche quotidienne /api/cron/expire-subscriptions (Vercel l'envoie automatiquement).
CRON_SECRET=

# ── Emails (Resend — resend.com) ──────────────────────────────────────────────
RESEND_API_KEY=
# Expéditeur général (domaine vérifié dans Resend).
RESEND_FROM=Import-eXPert <no-reply@votre-domaine.ma>
# Expéditeur des pro-formas, factures et rappels (facultatif, sinon RESEND_FROM).
RESEND_FROM_BILLING=RIGORIS LEX — Abonnements <abonnement@rigorislex.ma>
# Destinataire des alertes « justificatif de virement déposé » (facultatif,
# sinon l'email de facturation saisi dans les paramètres de facturation).
BILLING_ADMIN_EMAIL=

# ── Intelligence artificielle (modules assistant, classement, recherche) ──────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COST_ALERT_THRESHOLD_USD=5

# ── Facultatif ────────────────────────────────────────────────────────────────
# Synthèse vocale
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Limitation de débit (Upstash Redis) — sans ces variables, la limitation est désactivée ou locale
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_DEMO_MODE=
