# deploy/vps/env.example
# ─────────────────────────────────────────────────────────────────────────────
# Liste des variables utilisées par le code (relevées dans pages/, lib/,
# middleware.ts). À copier dans /srv/ixp/<env>/shared/.env.production avec
# les valeurs actuelles de Vercel (projet trans-txp → Settings → Environment
# Variables). Fichier réel : chmod 600, propriétaire ixp, JAMAIS commité.
# Les variables NEXT_PUBLIC_* sont figées à la construction : après les avoir
# changées, relancer deploy.sh.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://www.import-expert.ma
NEXT_PUBLIC_DEMO_MODE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
COST_ALERT_THRESHOLD_USD=

# Sessions et administration
USER_SECRET=
USER_SESSION_TTL=
ADMIN_SECRET=
ADMIN_SESSION_TTL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_BILLING=
BILLING_ADMIN_EMAIL=

# Limitation de débit (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tâche planifiée
CRON_SECRET=
